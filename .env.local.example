# Copia este ficheiro para .env.local e preenche com os valores do teu projeto
# Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloca-aqui-a-anon-key

# NUNCA exponhas esta chave no browser — só é usada em server actions
# (ex: criar utilizadores a partir do painel Super Admin).
SUPABASE_SERVICE_ROLE_KEY=coloca-aqui-a-service-role-key
