# Copia este ficheiro para .env.local e preenche com os valores do teu projeto
# Supabase (Project Settings → API) e das restantes integrações abaixo.
# NUNCA preenchas valores reais neste ficheiro (.env.local.example) — só em
# .env.local, que está sempre no .gitignore e nunca é commitado.

# --- URL pública da app (recomendado em produção) -----------------------
# Usada só para construir links enviados por email (ex: reset de password
# feito por um Admin a outro utilizador) e o redirect_uri do OAuth do Google
# Sheets — nunca derivada do cabeçalho Host do pedido (Host Header
# Injection), sempre desta env var. Sem isto definido, cai para
# https://$VERCEL_URL (o domínio .vercel.app, não o domínio próprio, se
# tiveres um) e depois para localhost:3000.
# SEM prefixo NEXT_PUBLIC_ de propósito: só é lida em código server-only
# (Server Actions/route handlers), nunca no browser — não há motivo para
# expor o valor no bundle do cliente. Na Vercel, define-a como variável
# privada/"Sensitive" (não marcar como pública), não precisa de estar
# disponível no browser.
APP_URL=https://o-teu-dominio.pt

# --- Supabase (obrigatório) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloca-aqui-a-anon-key

# NUNCA exponhas esta chave no browser — só é usada em server actions/rotas
# server-side (ex: criar utilizadores a partir do painel Super Admin, gerar
# o PDF do fecho, o cron de Web Push). lib/supabase/server.ts tem
# "server-only" a impedir que este ficheiro seja importado por engano num
# componente "use client".
SUPABASE_SERVICE_ROLE_KEY=coloca-aqui-a-service-role-key

# --- Web Push (opcional — notificações de risco de atraso ao Técnico) ---
# Gerar o par de chaves VAPID: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=coloca-aqui-a-chave-publica-vapid
VAPID_PRIVATE_KEY=coloca-aqui-a-chave-privada-vapid
VAPID_SUBJECT=mailto:o-teu-email@exemplo.pt
# Segredo partilhado que o job pg_cron (schema.sql) envia no cabeçalho
# x-sync-secret ao chamar /api/push/check-delays — gera um valor aleatório
# forte (ex: `openssl rand -hex 32`) e usa o MESMO valor no agendamento do
# pg_cron (ver instruções em schema.sql/migration-production.sql).
PUSH_CHECK_SECRET=coloca-aqui-um-valor-aleatorio-forte

# --- Integração Google Sheets (opcional) ---------------------------------
GOOGLE_SHEETS_CLIENT_ID=coloca-aqui-o-client-id-oauth-google
GOOGLE_SHEETS_CLIENT_SECRET=coloca-aqui-o-client-secret-oauth-google
# Segredo partilhado que a função enqueue_sheets_sync (Postgres) envia no
# cabeçalho x-sync-secret ao chamar /api/integrations/google-sheets/process
# — gera um valor aleatório forte (ex: `openssl rand -hex 32`) e insere o
# MESMO valor na tabela app_secrets via SQL Editor (nunca neste ficheiro
# nem em nenhum ficheiro versionado — ver instruções no fim de
# supabase/migration-production.sql).
SHEETS_SYNC_SECRET=coloca-aqui-um-valor-aleatorio-forte
# Injetado automaticamente pela Vercel em produção quando o projeto tem
# Cron Jobs configurados (vercel.json) — só precisas de definir localmente
# se quiseres testar o GET de recuperação (varredura de todas as empresas)
# à mão fora da Vercel.
CRON_SECRET=coloca-aqui-um-valor-aleatorio-forte
